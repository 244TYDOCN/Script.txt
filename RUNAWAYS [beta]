-- 4. ปุ่ม Teleport
local function teleport(cf)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then TweenService:Create(root, TweenInfo.new(0.5), {CFrame = cf}):Play() end
end

