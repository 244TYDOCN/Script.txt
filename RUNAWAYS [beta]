local camera = workspace.CurrentCamera

-- ตัวแปรฟังก์ชัน (ตั้งค่า Speed เริ่มต้นเป็น 5.0)
local isActive = false
local ghostModel = nil
local flySpeed = 5.0
local verticalVelocity = 0

