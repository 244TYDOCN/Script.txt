scrollFrame.ScrollBarThickness = 4
Instance.new("UIListLayout", scrollFrame).Padding = UDim.new(0, 5)

-- ฟังก์ชันสร้างปุ่ม
local function createBtn(text, color, callback)
    local btn = Instance.new("TextButton", scrollFrame)
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- 2. ส่วน FLY / DESYNC
createBtn("START DESYNC (FLY)", Color3.fromRGB(0, 170, 0), function()
    isActive = not isActive
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if isActive then
        ghostModel = Instance.new("Part", workspace)
        ghostModel.Size = Vector3.new(2, 3, 2)
        ghostModel.Transparency = 1; ghostModel.Anchored = true; ghostModel.CFrame = root.CFrame
        root.Anchored = true
        camera.CameraSubject = ghostModel
    else
        if ghostModel then root.CFrame = ghostModel.CFrame; ghostModel:Destroy() end
        root.Anchored = false
        camera.CameraSubject = char:FindFirstChildOfClass("Humanoid")
    end
end)

-- ปุ่ม Up/Down
local controlsFrame = Instance.new("Frame", scrollFrame)
controlsFrame.Size = UDim2.new(1, 0, 0, 40)
controlsFrame.BackgroundTransparency = 1
local upBtn = Instance.new("TextButton", controlsFrame)
upBtn.Size = UDim2.new(0.48, 0, 1, 0); upBtn.Position = UDim2.new(0, 0, 0, 0); upBtn.Text = "↑ UP"; upBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60); upBtn.Parent = controlsFrame
local downBtn = Instance.new("TextButton", controlsFrame)
downBtn.Size = UDim2.new(0.48, 0, 1, 0); downBtn.Position = UDim2.new(0.52, 0, 0, 0); downBtn.Text = "↓ DOWN"; downBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60); downBtn.Parent = controlsFrame

upBtn.MouseButton1Down:Connect(function() verticalVelocity = flySpeed end); upBtn.MouseButton1Up:Connect(function() verticalVelocity = 0 end)
downBtn.MouseButton1Down:Connect(function() verticalVelocity = -flySpeed end); downBtn.MouseButton1Up:Connect(function() verticalVelocity = 0 end)

