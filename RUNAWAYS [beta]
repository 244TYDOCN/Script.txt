-- Loop เคลื่อนที่
RunService.RenderStepped:Connect(function()
    if isActive and ghostModel then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.MoveDirection.Magnitude > 0 then
            ghostModel.CFrame = ghostModel.CFrame + (camera.CFrame:VectorToWorldSpace(camera.CFrame:VectorToObjectSpace(hum.MoveDirection)) * flySpeed)
        end
        ghostModel.CFrame = ghostModel.CFrame + Vector3.new(0, verticalVelocity, 0)
    end
end)
